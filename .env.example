# ===== 필수 =====
# OpenRouter API 키 (https://openrouter.ai/keys)
# 데일리 브리핑 + 주간 리포트 + 주간 AI 단신 생성기(/weekly-flash) 공통 사용. 서버에서만 사용됨.
# 웹 검색 grounding은 OpenRouter web_search 서버 도구(Exa)로 수행 — 별도 검색 과금 발생.
OPENROUTER_API_KEY=your_openrouter_api_key

# ===== 주간 AI 단신 생성기 (/weekly-flash) =====
# LLM 모델을 env 로 분리. 비워두면 PRO_MODEL(gemini-models.ts) 기본값 사용.
# OpenRouter 모델 슬러그로 지정할 것. 예) deepseek/deepseek-v4.1-flash
WEEKLY_FLASH_MODEL=

# ===== 뉴스 수집 (데일리 브리핑용, 선택) =====
BRAVE_SEARCH_API_KEY=your_brave_api_key
TAVILY_API_KEY=your_tavily_api_key

# ===== 데이터 저장소 (데일리 브리핑용) =====
# 로컬 개발은 파일시스템(data/), 프로덕션은 Vercel KV/Redis 자동 감지
REDIS_URL=
REDIS_PREFIX=

# ===== 스케줄러/크론 보안 (선택) =====
CRON_SECRET=
